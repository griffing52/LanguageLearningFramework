# Environment configuration template
# Copy this file to .env and adjust values as needed

# API Configuration
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=False
API_RELOAD=True
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origin URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
VITE_API_URL=http://127.0.0.1:5000/api

# Data Paths (relative to repository root)
DATA_ROOT=data
WORDS_FILE=data/seed/words.txt
LESSONS_FILE=data/seed/lesson1.txt
MEMORY_FILE=data/state/mem0
AUDIO_DIR=data/audio

# Logging
# LOG_FILE=logs/api.log

# -----------------------------------------------------------------------------
# TTS Provider Bootstrap (API machine)
# If set, API will auto-expose this provider even when tts_providers.json is empty.
# -----------------------------------------------------------------------------
TTS_REMOTE_PROVIDER_ID=remote-tts
TTS_REMOTE_PROVIDER_NAME=Remote TTS Server
TTS_REMOTE_BASE_URL=http://127.0.0.1:7001
TTS_REMOTE_SYNTHESIZE_PATH=/synthesize
TTS_REMOTE_HEALTH_PATH=/health
TTS_REMOTE_API_KEY=
# JSON object string, for example: {"X-API-Key":"abc"}
TTS_REMOTE_EXTRA_HEADERS=

# -----------------------------------------------------------------------------
# Standalone TTS Server (inference machine)
# Used by tools/tts/server.py
# -----------------------------------------------------------------------------
TTS_SERVER_HOST=0.0.0.0
TTS_SERVER_PORT=7001
TTS_SERVER_OUTPUT_DIR=tools/tts/output
TTS_SERVER_DEFAULT_METHOD=speecht5
TTS_SERVER_RETURN_AUDIO_BASE64=true

# -----------------------------------------------------------------------------
# SpeechT5 backend settings (inference machine)
# -----------------------------------------------------------------------------
TTS_SPEECHT5_CHECKPOINT=microsoft/speecht5_tts
TTS_SPEECHT5_MODEL=griffing52/speecht5_finetuned_griffin_ch_lu
TTS_SPEECHT5_VOCODER=microsoft/speecht5_hifigan
TTS_SPEECHT5_SAMPLE_RATE=16000
# Required for SpeechT5 calls
TTS_SPEECHT5_SPEAKER_EMBEDDINGS=

# -----------------------------------------------------------------------------
# Legacy stitched backend settings (inference machine)
# -----------------------------------------------------------------------------
TTS_LEGACY_ROOT=tools/tts/SwissGermanLanguage
TTS_LEGACY_MODE=stitched

# -----------------------------------------------------------------------------
# Orpheus backend settings (inference machine)
# -----------------------------------------------------------------------------
TTS_ORPHEUS_MODEL_ID=griffing52/orpheus-swiss-german-lora
# Optional dedicated endpoint URL; if set, overrides TTS_ORPHEUS_MODEL_ID
TTS_ORPHEUS_ENDPOINT_URL=
# Hugging Face token for private/gated models or higher quota
HF_TOKEN=
